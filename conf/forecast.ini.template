; =============================================================================
; timeseries-grafana — grafana.ini fragment
; =============================================================================
; Snapshot store, compute hop, Vault and the retrain scheduler for
;   [plugin.eduardkolotushin-forecast-app]       (gpx_forecast, the app backend)
;   [plugin.eduardkolotushin-forecast-datasource] (gpx_forecast, alerting QueryData)
; Merge both sections into grafana.ini (or custom.ini). Grafana expands ${VAR}.
; CI/CD may substitute the placeholders instead of relying on Grafana expansion.
;
; Each [plugin.<id>] section belongs to one process. Inside a section the
; COMPONENT blocks group one peer; the FUNCTION blocks group why its keys exist.
; INI order does not matter; this order is for operators.
;
; SECRETS — prefer secureJsonData or the pod's Secret env over a literal here:
;   app:        secureJsonData.vaultToken, .vaultSecretId, .computeToken,
;               .grafanaToken, .storePassword
;   datasource: secureJsonData.vaultToken, .vaultSecretId, .storePassword
;
; CERTIFICATES ARE PATHS, NOT CONTENT. Every *_ca_cert, *_client_cert and
; *_client_key value is a file path; a value containing a PEM block is rejected.
;
; PRECEDENCE in gpx_forecast: FORECAST_* env (only if Grafana forwards host env;
; Grafana 12.4+ does not by default), then GF_PLUGIN_* for this process's plugin
; id, then the id-less GF_PLUGIN_<KEY> Grafana 13 exports for this same section
; ([plugin.<id>] store_host arrives as GF_PLUGIN_STORE_HOST), then this plugin
; section via GrafanaCfg, then jsonData. The compute service and
; gpx_forecast_migrate read process env only.
;
; =============================================================================


[plugin.eduardkolotushin-forecast-app]

; -----------------------------------------------------------------------------
; COMPONENT: Vault — shared PKI/authentication endpoint
; -----------------------------------------------------------------------------
; Leave vault_addr empty (the default) for no Vault. The compute, PVV and store
; components then keep their plain/file behaviour. Vault is also the fourth
; selectable mTLS hop (v21): the connection to Vault can require its own client
; certificate, which cannot come from the same Vault.

; FUNCTION: connection
; vault_addr = ${FORECAST_VAULT_ADDR}
; vault_namespace = ${FORECAST_VAULT_NAMESPACE}
; vault_ca_cert = ${FORECAST_VAULT_CA_CERT}
; vault_tls_skip_verify = ${FORECAST_VAULT_TLS_SKIP_VERIFY}

; FUNCTION: authentication
; Precedence: token, then AppRole, then Kubernetes. Use a Secret-backed token.
; vault_token = ${FORECAST_VAULT_TOKEN}
; vault_role_id = ${FORECAST_VAULT_ROLE_ID}
; vault_secret_id = ${FORECAST_VAULT_SECRET_ID}
; vault_approle_mount = ${FORECAST_VAULT_APPROLE_MOUNT}
; vault_k8s_role = ${FORECAST_VAULT_K8S_ROLE}
; vault_k8s_mount = ${FORECAST_VAULT_K8S_MOUNT}
; vault_k8s_jwt_path = ${FORECAST_VAULT_K8S_JWT_PATH}

; FUNCTION: PKI issuance defaults
; pki_mount defaults to "pki"; cert_ttl requests the leaf lifetime (default 24h).
; vault_pki_mount = ${FORECAST_VAULT_PKI_MOUNT}
; vault_cert_ttl = ${FORECAST_VAULT_CERT_TTL}

; FUNCTION: client certificate for the Vault connection itself (v21)
; File paths only. Both are required when vault_mtls is on; unset defaults to
; "either path is set" (a lone half is an error). Read once: rotate with a restart.
; vault_mtls = ${FORECAST_VAULT_MTLS}
; vault_client_cert = ${FORECAST_VAULT_CLIENT_CERT}
; vault_client_key = ${FORECAST_VAULT_CLIENT_KEY}

; -----------------------------------------------------------------------------
; COMPONENT: compute service — plugin → gpx_forecast_compute
; -----------------------------------------------------------------------------

; FUNCTION: forwarding
; Empty keeps every fit and the retrain ticker in this process. Set the
; standalone service's base URL and this process forwards /forecast instead,
; running no ticker; the service then owns the ticker over the same store.
compute_url = ${FORECAST_COMPUTE_URL}
; Shared secret the service requires. Required by the service; this process only
; warns when missing, because forwarded calls then fail upstream with 401.
compute_token = ${FORECAST_COMPUTE_TOKEN}

; FUNCTION: mTLS
; compute_mtls turns the forwarded hop into https + a required client cert.
; Unset defaults to "vault_pki_role is configured"; false keeps plain HTTP.
; A true flag without the role is a loud per-component error.
; compute_mtls = ${FORECAST_COMPUTE_MTLS}
; vault_pki_role = ${FORECAST_VAULT_PKI_ROLE}
; CN of the plugin's client certificate (default gpx-forecast).
; vault_client_cn = ${FORECAST_VAULT_CLIENT_CN}
; DNS name the service's certificate is issued for and verified against.
; compute_tls_server_name = ${FORECAST_COMPUTE_TLS_SERVER_NAME}

; -----------------------------------------------------------------------------
; COMPONENT: snapshot store — Postgres
; -----------------------------------------------------------------------------

; FUNCTION: connection
; A store_url short-circuits the field-wise keys. Empty store_host and store_url
; means persist is off (always needTrain).
; store_url = ${FORECAST_STORE_URL}
store_host = ${FORECAST_STORE_HOST}
store_port = ${FORECAST_STORE_PORT}
store_database = ${FORECAST_STORE_DATABASE}
store_user = ${FORECAST_STORE_USER}
store_ssl_mode = ${FORECAST_STORE_SSLMODE}
store_password = ${FORECAST_STORE_PASSWORD}

; FUNCTION: retention
; How long a snapshot nothing refreshed may live (retrain ticker's sweep;
; default 72h, 0 disables, below 1h falls back to the default).
; snapshot_ttl = ${FORECAST_SNAPSHOT_TTL}

; FUNCTION: mTLS
; store_mtls makes pgx present a Vault-issued client certificate to Postgres.
; Unset defaults to "vault_pki_store_role is configured"; false keeps the
; sslmode-only connection. The CN defaults to store_user, or vault_store_cn.
; store_mtls = ${FORECAST_STORE_MTLS}
; vault_pki_store_role = ${FORECAST_VAULT_PKI_STORE_ROLE}
; vault_store_cn = ${FORECAST_VAULT_STORE_CN}

; -----------------------------------------------------------------------------
; COMPONENT: PVV — DataByRefId retrain transport
; -----------------------------------------------------------------------------

; FUNCTION: transport
; Set pvv_client_cert + pvv_client_key (or vault_pki_pvv_role) to switch the
; scheduler to PVV; it then claims panel rows across all orgs and fetches each
; with that row's org_id. pvv_url defaults to grafana_url. No Grafana token is
; sent to PVV. retrain_window_chunk is the sequential slice size (max 24h).
; pvv_url = ${FORECAST_PVV_URL}
; pvv_ca_cert = ${FORECAST_PVV_CA_CERT}
; pvv_tls_skip_verify = ${FORECAST_PVV_TLS_SKIP_VERIFY}
; retrain_window_chunk = ${FORECAST_RETRAIN_WINDOW_CHUNK}

; FUNCTION: mTLS
; pvv_mtls selects the Vault-issued client cert. Set false to keep the file pair
; as the only possible source. pvv_client_cert/key are paths, not PEM content.
; pvv_mtls = ${FORECAST_PVV_MTLS}
; pvv_client_cert = ${FORECAST_PVV_CLIENT_CERT}
; pvv_client_key = ${FORECAST_PVV_CLIENT_KEY}
; Setting this role also selects PVV mode; CN defaults to gpx-forecast-pvv.
; vault_pki_pvv_role = ${FORECAST_VAULT_PKI_PVV_ROLE}
; vault_pvv_cn = ${FORECAST_VAULT_PVV_CN}

; -----------------------------------------------------------------------------
; COMPONENT: retrain scheduler — this process only, unless compute_url moves it
; -----------------------------------------------------------------------------
; The datasource section never runs the ticker. The scheduler claims due rows
; from forecast.retrain; one ticker may run here or in the compute service.

; FUNCTION: schedule and reliability
; retrain_retry_max must exceed retrain_lease; otherwise the default is kept.
retrain_enabled = ${FORECAST_RETRAIN_ENABLED}
retrain_tick = ${FORECAST_RETRAIN_TICK}
retrain_lease = ${FORECAST_RETRAIN_LEASE}
retrain_retry_max = ${FORECAST_RETRAIN_RETRY_MAX}
retrain_cron = ${FORECAST_RETRAIN_CRON}

; FUNCTION: Grafana frame source
; Reach Grafana directly, from whichever process ticks: 127.0.0.1:3000 here,
; Grafana's Service from a compute container (plus serve_from_sub_path when on).
; Never an IAM/forward-auth URL: that proxy replaces Authorization and needs a
; browser session, which an unattended call has neither of. Empty grafana_url
; means http://127.0.0.1:3000. grafana_token is a Viewer service-account token.
grafana_url = ${FORECAST_GRAFANA_URL}
grafana_token = ${FORECAST_GRAFANA_TOKEN}

; -----------------------------------------------------------------------------
; COMPONENT: process — concurrency in this plugin backend
; -----------------------------------------------------------------------------

; FUNCTION: in-flight work
; Concurrent Fit / ForecastRange slots (default 4; with compute_url this process
; forwards instead of fitting and the default is 32).
max_inflight = ${FORECAST_MAX_INFLIGHT}


[plugin.eduardkolotushin-forecast-datasource]
; Alerting QueryData is a second gpx_forecast process. It restores snapshots and
; computes ForecastRange; it never forwards to compute and never runs the
; retrain ticker, so only the store, Vault (for store mTLS) and its own
; concurrency limit apply here.

; -----------------------------------------------------------------------------
; COMPONENT: snapshot store — Postgres
; -----------------------------------------------------------------------------

; FUNCTION: connection
; store_url = ${FORECAST_STORE_URL}
store_host = ${FORECAST_STORE_HOST}
store_port = ${FORECAST_STORE_PORT}
store_database = ${FORECAST_STORE_DATABASE}
store_user = ${FORECAST_STORE_USER}
store_ssl_mode = ${FORECAST_STORE_SSLMODE}
store_password = ${FORECAST_STORE_PASSWORD}

; FUNCTION: mTLS
; Required for a Vault-issued store client certificate in this process.
; store_mtls = ${FORECAST_STORE_MTLS}
; vault_pki_store_role = ${FORECAST_VAULT_PKI_STORE_ROLE}
; vault_store_cn = ${FORECAST_VAULT_STORE_CN}

; -----------------------------------------------------------------------------
; COMPONENT: Vault — connection, auth and issuance for the store certificate
; -----------------------------------------------------------------------------
; Only needed when store_mtls is on. The datasource has no compute or PVV role.

; FUNCTION: connection
; vault_addr = ${FORECAST_VAULT_ADDR}
; vault_namespace = ${FORECAST_VAULT_NAMESPACE}
; vault_ca_cert = ${FORECAST_VAULT_CA_CERT}
; vault_tls_skip_verify = ${FORECAST_VAULT_TLS_SKIP_VERIFY}

; FUNCTION: authentication
; vault_token = ${FORECAST_VAULT_TOKEN}
; vault_role_id = ${FORECAST_VAULT_ROLE_ID}
; vault_secret_id = ${FORECAST_VAULT_SECRET_ID}
; vault_approle_mount = ${FORECAST_VAULT_APPROLE_MOUNT}
; vault_k8s_role = ${FORECAST_VAULT_K8S_ROLE}
; vault_k8s_mount = ${FORECAST_VAULT_K8S_MOUNT}
; vault_k8s_jwt_path = ${FORECAST_VAULT_K8S_JWT_PATH}

; FUNCTION: PKI issuance defaults
; vault_pki_mount = ${FORECAST_VAULT_PKI_MOUNT}
; vault_cert_ttl = ${FORECAST_VAULT_CERT_TTL}

; FUNCTION: client certificate for the Vault connection itself (v21)
; vault_mtls = ${FORECAST_VAULT_MTLS}
; vault_client_cert = ${FORECAST_VAULT_CLIENT_CERT}
; vault_client_key = ${FORECAST_VAULT_CLIENT_KEY}

; -----------------------------------------------------------------------------
; COMPONENT: process — concurrency in this datasource backend
; -----------------------------------------------------------------------------

; FUNCTION: in-flight work
; Concurrent Restore / ForecastRange slots in this process (default 4).
max_inflight = ${FORECAST_MAX_INFLIGHT}
