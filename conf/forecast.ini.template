; Snapshot store for eduardkolotushin-forecast-app and the nested
; eduardkolotushin-forecast-datasource (alerting QueryData is a second process).
; Merge both sections into grafana.ini (or custom.ini). Grafana expands ${VAR}.
; Empty store_host (and no store_url) means persist is off (always needTrain).
; CI/CD may substitute the placeholders instead of relying on Grafana expansion.
;
; Precedence in gpx_forecast: FORECAST_STORE_* env (only if Grafana forwards host
; env; Grafana 12.4+ does not by default), then GF_PLUGIN_* for this process's
; plugin id, then the id-less GF_PLUGIN_<KEY> Grafana 13 exports for this same
; section ([plugin.<id>] store_host arrives as GF_PLUGIN_STORE_HOST), then this
; plugin section via GrafanaCfg, then jsonData
; (provisioned app or Forecast datasource jsonData; the plugin's pages
; render no store fields).

[plugin.eduardkolotushin-forecast-app]
; Optional full DSN. If set, the fields below are ignored.
; store_url = ${FORECAST_STORE_URL}
store_host = ${FORECAST_STORE_HOST}
store_port = ${FORECAST_STORE_PORT}
store_database = ${FORECAST_STORE_DATABASE}
store_user = ${FORECAST_STORE_USER}
store_ssl_mode = ${FORECAST_STORE_SSLMODE}
store_password = ${FORECAST_STORE_PASSWORD}
; How long a snapshot nothing refreshed may live (the retrain ticker's retention sweep;
; default 72h, 0 disables, a value below 1h falls back to the default).
; snapshot_ttl = ${FORECAST_SNAPSHOT_TTL}
; Concurrent Fit / ForecastRange slots in this process (default 4; when compute_url
; below is set, this process forwards instead of fitting and the default is 32).
max_inflight = ${FORECAST_MAX_INFLIGHT}
; Where fitting runs. Empty (the default) keeps every fit and the retrain ticker
; in this process. Set it to the standalone compute service's base URL
; (gpx_forecast_compute, env FORECAST_COMPUTE_LISTEN, default :8080) and this
; process forwards /forecast to that service and runs no ticker; the service needs
; FORECAST_COMPUTE_TOKEN and runs its own ticker against the same store. The
; service reads process env only (no ini, no jsonData), and it ignores this key.
compute_url = ${FORECAST_COMPUTE_URL}
; Shared secret the compute service requires on every forwarded request. The
; service refuses to start without it; this process only warns when it is
; missing, because the forwarded calls are then refused with 401 upstream.
compute_token = ${FORECAST_COMPUTE_TOKEN}
; v19/v20: mTLS from Vault's PKI secrets engine. Leave vault_addr empty (the
; default) for plain traffic, exactly as before. The three components are
; switched independently: compute (plugin -> gpx_forecast_compute), PVV
; (DataByRefId retrain transport), and the Postgres snapshot store. Each
; *_mtls flag defaults to "that component's role is configured"; set it to
; false to turn a component off even when its role exists (for example when
; Istio terminates mTLS in Kubernetes). A flag set true without its role is a
; loud per-component error, never a plaintext fallback.
; compute_mtls turns the forwarded hop into https + a required client cert;
; pvv_mtls selects the Vault-issued PVV client cert; store_mtls makes pgx
; present a Vault-issued client certificate to Postgres.
; Auth precedence: token, then AppRole, then Kubernetes. The token/secret_id are
; secrets; prefer secureJsonData.vaultToken / secureJsonData.vaultSecretId (or
; the pod's Secret env) over this file. The compute service and the migration
; CLI read process env only, so they take the FORECAST_VAULT_* spellings.
; vault_addr = ${FORECAST_VAULT_ADDR}
; vault_namespace = ${FORECAST_VAULT_NAMESPACE}
; vault_token = ${FORECAST_VAULT_TOKEN}
; vault_role_id = ${FORECAST_VAULT_ROLE_ID}
; vault_secret_id = ${FORECAST_VAULT_SECRET_ID}
; vault_approle_mount = ${FORECAST_VAULT_APPROLE_MOUNT}
; vault_k8s_role = ${FORECAST_VAULT_K8S_ROLE}
; vault_k8s_mount = ${FORECAST_VAULT_K8S_MOUNT}
; vault_k8s_jwt_path = ${FORECAST_VAULT_K8S_JWT_PATH}
; vault_pki_mount = ${FORECAST_VAULT_PKI_MOUNT}
; compute_mtls = ${FORECAST_COMPUTE_MTLS}
; vault_pki_role = ${FORECAST_VAULT_PKI_ROLE}
; pvv_mtls = ${FORECAST_PVV_MTLS}
; Optional: issue the PVV client certificate from Vault instead of the
; pvv_client_cert/key files. Setting this role also selects PVV mode.
; vault_pki_pvv_role = ${FORECAST_VAULT_PKI_PVV_ROLE}
; store_mtls = ${FORECAST_STORE_MTLS}
; Role used to issue the store's client certificate. The certificate CN defaults
; to the resolved store user (store_user below), or vault_store_cn when set.
; vault_pki_store_role = ${FORECAST_VAULT_PKI_STORE_ROLE}
; vault_store_cn = ${FORECAST_VAULT_STORE_CN}
; vault_cert_ttl = ${FORECAST_VAULT_CERT_TTL}
; vault_client_cn = ${FORECAST_VAULT_CLIENT_CN}
; vault_pvv_cn = ${FORECAST_VAULT_PVV_CN}
; vault_ca_cert = ${FORECAST_VAULT_CA_CERT}
; vault_tls_skip_verify = ${FORECAST_VAULT_TLS_SKIP_VERIFY}
; DNS name the compute service's certificate is issued for and the client
; verifies. Required on the service when compute_mtls is on; defaults to the
; compute URL's hostname in this process.
; compute_tls_server_name = ${FORECAST_COMPUTE_TLS_SERVER_NAME}
; Unattended retrain scheduler. Only this process (the app) runs it, unless
; compute_url above moves it to the compute service; the datasource section below
; never runs it, because alerting QueryData only Restores.
; The scheduler claims due rows from forecast.retrain. In Grafana mode it calls
; GET /api/org once and POST /api/ds/query per row, both with its own Grafana
; token; PVV mode (pvv_client_cert/key below) instead claims every org's panel
; rows and posts DataByRefId over mTLS. Point this at
; Grafana itself, reached directly by whichever process ticks: 127.0.0.1:3000 for
; this process, Grafana's service name from a compute-service container (and the
; sub-path Grafana serves under, when serve_from_sub_path is on). Never at an
; IAM/forward-auth URL in front of Grafana: that proxy replaces the Authorization
; header and needs a browser session, which an unattended call has neither of.
; Leave retrain_enabled empty (or true) to run it. Empty grafana_url means
; http://127.0.0.1:3000.
retrain_enabled = ${FORECAST_RETRAIN_ENABLED}
retrain_tick = ${FORECAST_RETRAIN_TICK}
retrain_lease = ${FORECAST_RETRAIN_LEASE}
; Cap on the exponential retry backoff for a failed row (default 1h; a value that
; does not exceed retrain_lease is refused and the default kept).
retrain_retry_max = ${FORECAST_RETRAIN_RETRY_MAX}
retrain_cron = ${FORECAST_RETRAIN_CRON}
grafana_url = ${FORECAST_GRAFANA_URL}
; Viewer service-account token of the org that owns the panels, for /api/org and
; /api/ds/query. Not an IAM user token: those expire with a browser session.
grafana_token = ${FORECAST_GRAFANA_TOKEN}
; PVV DataByRefId retrain transport. Set both the client certificate and key to
; switch the scheduler to PVV; it then claims panel rows across all orgs and
; fetches each with that row's org_id. pvv_url defaults to grafana_url. The
; endpoint is /gse/data/v1/DataByRefId; no Grafana token is sent to PVV.
; pvv_url = ${FORECAST_PVV_URL}
; pvv_client_cert = ${FORECAST_PVV_CLIENT_CERT}
; pvv_client_key = ${FORECAST_PVV_CLIENT_KEY}
; pvv_ca_cert = ${FORECAST_PVV_CA_CERT}
; pvv_tls_skip_verify = ${FORECAST_PVV_TLS_SKIP_VERIFY}
; retrain_window_chunk = ${FORECAST_RETRAIN_WINDOW_CHUNK}

[plugin.eduardkolotushin-forecast-datasource]
; Same keys as the app. Alerting QueryData does not receive app jsonData.
; store_url = ${FORECAST_STORE_URL}
store_host = ${FORECAST_STORE_HOST}
store_port = ${FORECAST_STORE_PORT}
store_database = ${FORECAST_STORE_DATABASE}
store_user = ${FORECAST_STORE_USER}
store_ssl_mode = ${FORECAST_STORE_SSLMODE}
store_password = ${FORECAST_STORE_PASSWORD}
; Concurrent Restore / ForecastRange slots in this process (default 4).
max_inflight = ${FORECAST_MAX_INFLIGHT}
