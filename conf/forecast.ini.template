; Snapshot store for eduardkolotushin-forecast-app and the nested
; eduardkolotushin-forecast-datasource (alerting QueryData is a second process).
; Merge both sections into grafana.ini (or custom.ini). Grafana expands ${VAR}.
; Empty store_host (and no store_url) means persist is off (always needTrain).
; CI/CD may substitute the placeholders instead of relying on Grafana expansion.
;
; Precedence in gpx_forecast: FORECAST_STORE_* env (only if Grafana forwards host
; env; Grafana 12.4+ does not by default), then GF_PLUGIN_* for this process's
; plugin id, then this plugin section via GrafanaCfg, then jsonData
; (app Configuration page, or Forecast datasource jsonData).

[plugin.eduardkolotushin-forecast-app]
; Optional full DSN. If set, the fields below are ignored.
; store_url = ${FORECAST_STORE_URL}
store_host = ${FORECAST_STORE_HOST}
store_port = ${FORECAST_STORE_PORT}
store_database = ${FORECAST_STORE_DATABASE}
store_user = ${FORECAST_STORE_USER}
store_ssl_mode = ${FORECAST_STORE_SSLMODE}
store_password = ${FORECAST_STORE_PASSWORD}
; Concurrent Fit / ForecastRange slots in this process (default 4).
max_inflight = ${FORECAST_MAX_INFLIGHT}
; Unattended retrain scheduler. Only this process (the app) runs it; the
; datasource section below does not, because alerting QueryData only Restores.
; The scheduler claims due rows from forecast.retrain and fetches its own
; training data from Grafana's /api/ds/query. Leave retrain_enabled empty (or
; true) to run it. Empty grafana_url means http://127.0.0.1:3000.
retrain_enabled = ${FORECAST_RETRAIN_ENABLED}
retrain_tick = ${FORECAST_RETRAIN_TICK}
retrain_lease = ${FORECAST_RETRAIN_LEASE}
retrain_cron = ${FORECAST_RETRAIN_CRON}
grafana_url = ${FORECAST_GRAFANA_URL}
; Viewer service-account token for /api/ds/query when anonymous auth is off.
grafana_token = ${FORECAST_GRAFANA_TOKEN}

[plugin.eduardkolotushin-forecast-datasource]
; Same keys as the app. Alerting QueryData does not receive app jsonData.
; store_url = ${FORECAST_STORE_URL}
store_host = ${FORECAST_STORE_HOST}
store_port = ${FORECAST_STORE_PORT}
store_database = ${FORECAST_STORE_DATABASE}
store_user = ${FORECAST_STORE_USER}
store_ssl_mode = ${FORECAST_STORE_SSLMODE}
store_password = ${FORECAST_STORE_PASSWORD}
; Concurrent Restore / ForecastRange slots in this process (default 4).
max_inflight = ${FORECAST_MAX_INFLIGHT}
